+# FORGE field model: logistic P(fold | post-flop response to a bet/raise), fitted on 135 counted
+# Saturday tables (tools/forge_ctx/field_coef.json). Size bins = bettor's added chips / pot before.
+CTX_EDGES = (0.3, 0.45, 0.6, 0.8, 1.1)
+CTX_SZ = (0.0, 1.1986, 1.7936, 2.1053, 2.4595, 2.8549)
+CTX_C = -1.6268
+CTX_REF = 0.5 * (1.7936 + 2.1053)     # 0.6 pot = the size N's continue model is anchored to
+CTX_RAISE = -0.9618
+CTX_MW = 1.0558
+CTX_ST = {"flop": 0.0, "turn": -0.0067, "river": 0.5187}
+CTX_IP = -0.8887
+CTX_ALLIN = -0.2963
+CTX_MWIP = 0.2143
+CTX_K = 20.0
+
+
+def _sig(x):
+    return 1.0 / (1.0 + math.exp(-x))
+
+
+def _logit(p):
+    p = min(1 - 1e-6, max(1e-6, p))
+    return math.log(p / (1 - p))
+
