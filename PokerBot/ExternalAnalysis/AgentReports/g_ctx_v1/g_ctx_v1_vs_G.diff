+    def _learn_ctx(self, summary):
+        """Per seat: observed folds (xf), responses (xn) and field-expected folds (xe) facing post-flop bets."""
+        hist = summary.get("history") or []
+        n = self.n
+        start = self.start
+        contrib = [0] * n
+        bets = [0] * n
+        folded = [False] * n
+        sbs = None
+        street = "preflop"
+        cur = 0
+        naggr = 0
+        aggr = None
+        ratio = 0.0
+        for h in hist:
+            a = h.get("action")
+            s = h.get("seat")
+            amt = h.get("amount") or 0
+            st = h.get("street")
+            if st != street:
+                street = st
+                bets = [0] * n
+                cur = 0
+                naggr = 0
+                aggr = None
+            if a in ("small_blind", "big_blind"):
+                if a == "small_blind":
+                    sbs = s
+                contrib[s] += amt
+                bets[s] += amt
+                cur = max(cur, bets[s])
+                continue
+            to_call = cur - bets[s]
+            if street != "preflop" and to_call > 0 and aggr is not None and sbs is not None \
+                    and a in ("fold", "call", "raise"):
+                mw = 1 if sum(1 for j in range(n) if not folded[j] and j != s) >= 2 else 0
+                # ROOK fix: postflop order is from the button; heads-up the SB is the button
+                bt = sbs if n == 2 else (sbs - 1) % n
+                ip = 1 if (s - bt - 1) % n > (aggr - bt - 1) % n else 0
+                b = 0
+                while b < 5 and ratio >= CTX_EDGES[b]:
+                    b += 1
+                x = (CTX_C + CTX_SZ[b] + (CTX_RAISE if naggr > 1 else 0.0) + CTX_MW * mw
+                     + CTX_ST.get(street, 0.0) + CTX_IP * ip + CTX_MWIP * mw * ip
+                     + (CTX_ALLIN if to_call >= start - contrib[s] else 0.0))
+                o = self.S(s)
+                o.xn += 1
+                o.xe += _sig(x)
+                if a == "fold":
+                    o.xf += 1
+            if a == "raise":
+                add = amt - bets[s]
+                ratio = add / float(max(1, sum(contrib)))
+                contrib[s] += add
+                bets[s] = amt
+                cur = max(cur, amt)
+                naggr += 1
+                aggr = s
+            elif a == "call":
+                contrib[s] += amt
+                bets[s] += amt
+            elif a == "fold":
+                folded[s] = True
+
+    def ftb_ctx(self, j, street, mw, ip, raising):
+        """Fold-to-our-bet at 0.6 pot in this context: field logit + shrunk per-seat shift."""
+        o = self.S(j)
+        x = (CTX_C + CTX_REF + (CTX_RAISE if raising else 0.0) + CTX_MW * mw + CTX_ST.get(street, 0.0)
+             + CTX_IP * ip + CTX_MWIP * mw * ip)
+        if o.xn > 0:
+            ej = o.xe / o.xn
+            x += _logit((o.xf + CTX_K * ej) / (o.xn + CTX_K)) - _logit(ej)
+        return _sig(x)
+
